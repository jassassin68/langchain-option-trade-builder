# Development Environment Configuration

# Database Configuration
POSTGRES_DB=options_db_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=dev_password
POSTGRES_PORT=5432

# Redis Configuration
REDIS_PORT=6379
