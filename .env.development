# Cache TTL Settings (seconds) - shorter for development
TICKER_CACHE_TTL=1800
ANALYSIS_CACHE_TTL=900
MARKET_DATA_CACHE_TTL=180

# API Keys (use development/sandbox keys)
OPENAI_API_KEY=your_dev_openai_api_key_here
ALPHA_VANTAGE_API_KEY=your_dev_alpha_vantage_key_here
TRADIER_API_KEY=your_dev_tradier_api_key_here

# Supabase Configuration (optional for development)
