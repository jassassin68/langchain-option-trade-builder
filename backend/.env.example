# Database Configuration
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/options_db

# Supabase Configuration (alternative to local PostgreSQL)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Redis Configuration
REDIS_URL=redis://localhost:6379

# OpenAI Configuration (DEPRECATED - kept for rollback capability only)
# OPENAI_API_KEY is no longer needed with OpenRouter integration
# Keep this variable for emergency rollback to direct OpenAI integration
OPENAI_API_KEY=your_openai_api_key_here

# OpenRouter Configuration (PRIMARY LLM PROVIDER)
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
APP_URL=http://localhost:3000

# LLM Model Configuration
# Primary model: Fast, free-tier model from xAI
PRIMARY_MODEL=x-ai/grok-4.1-fast:free
# Fallback model: Reliable free-tier model from Mistral AI
FALLBACK_MODEL=mistralai/mistral-small-3.2-24b-instruct:free

# LLM Request Configuration
# Timeout for LLM requests in seconds
LLM_TIMEOUT=30
# Maximum tokens for LLM responses
LLM_MAX_TOKENS=4000
# Temperature for LLM responses (0.0 = deterministic)
LLM_TEMPERATURE=0.0
# Maximum retry attempts for failed requests
MAX_RETRIES=2

# External API Keys
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here
TRADIER_API_KEY=your_tradier_api_key_here

# Application Configuration
DEBUG=false
APP_NAME=Options Trade Evaluator

# Cache TTL Settings (seconds)
TICKER_CACHE_TTL=3600
ANALYSIS_CACHE_TTL=1800
MARKET_DATA_CACHE_TTL=300