# Production Environment Configuration
# WARNING: This file contains sensitive information. Do not commit to version control.

# Database Configuration
POSTGRES_DB=options_db_prod
POSTGRES_USER=options_user
POSTGRES_PASSWORD=CHANGE_ME_SECURE_PASSWORD

# Redis Configuration
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# Backend Configuration
BACKEND_PORT=8000
DEBUG=false

# Application Configuration
APP_NAME=Options Trade Evaluator

# Cache TTL Settings (seconds)
TICKER_CACHE_TTL=3600
ANALYSIS_CACHE_TTL=1800
MARKET_DATA_CACHE_TTL=300

# API Keys (use production keys)
OPENAI_API_KEY=CHANGE_ME_PRODUCTION_OPENAI_KEY
ALPHA_VANTAGE_API_KEY=CHANGE_ME_PRODUCTION_ALPHA_VANTAGE_KEY
TRADIER_API_KEY=CHANGE_ME_PRODUCTION_TRADIER_KEY

# Supabase Configuration (if using Supabase instead of local PostgreSQL)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=CHANGE_ME_SUPABASE_ANON_KEY